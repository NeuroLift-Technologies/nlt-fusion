{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nlt:world-engine:v1:snapshot",
  "title": "NLT World Engine Snapshot",
  "type": "object",
  "required": [
    "contract_version",
    "snapshot_id",
    "simulation",
    "avatars",
    "entities",
    "extensions"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contract_version"
    },
    "snapshot_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "simulation": {
      "type": "object",
      "required": [
        "simulation_id",
        "state",
        "tick",
        "sim_time",
        "seed",
        "pace"
      ],
      "properties": {
        "simulation_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "state": {
          "enum": [
            "initializing",
            "running",
            "paused",
            "completed",
            "error"
          ]
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "sim_time": {
          "type": "number",
          "minimum": 0
        },
        "seed": {
          "type": "integer"
        },
        "pace": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "avatars": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "name",
          "trait",
          "state",
          "emotional_state",
          "metrics",
          "scenario",
          "position",
          "counters",
          "extensions"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "trait": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "idle",
              "walking",
              "working",
              "drifting",
              "hyperfocus",
              "overwhelmed",
              "coached"
            ]
          },
          "emotional_state": {
            "type": "string",
            "minLength": 1
          },
          "metrics": {
            "$ref": "common.schema.json#/$defs/metrics"
          },
          "scenario": {
            "$ref": "common.schema.json#/$defs/scenario_state"
          },
          "position": {
            "$ref": "common.schema.json#/$defs/position"
          },
          "counters": {
            "type": "object",
            "required": [
              "minutes_focused",
              "false_starts",
              "interventions",
              "successes",
              "failures"
            ],
            "properties": {
              "minutes_focused": {
                "type": "number",
                "minimum": 0
              },
              "false_starts": {
                "type": "integer",
                "minimum": 0
              },
              "interventions": {
                "type": "integer",
                "minimum": 0
              },
              "successes": {
                "type": "integer",
                "minimum": 0
              },
              "failures": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "extensions": {
            "$ref": "common.schema.json#/$defs/extensions"
          }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
