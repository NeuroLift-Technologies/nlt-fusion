{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nlt:world-engine:v1:action",
  "title": "NLT World Engine Action",
  "type": "object",
  "required": [
    "contract_version",
    "action_id",
    "sequence",
    "submitted_at",
    "actor",
    "action_type",
    "target_id",
    "payload",
    "extensions"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contract_version"
    },
    "action_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "submitted_at": {
      "$ref": "common.schema.json#/$defs/clock"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "action_type": {
      "enum": [
        "assign_scenario",
        "move_to",
        "use_object",
        "rest",
        "advance_tick",
        "pause",
        "resume",
        "reset",
        "submit_intent",
        "coach",
        "extension"
      ]
    },
    "target_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
