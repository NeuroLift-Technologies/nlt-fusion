WorldEngine/Content/Fab/Modern_City_Environment/grid_system.uasset filter=lfs diff=lfs merge=lfs -text

# Golden fixtures are byte-exact reference data for the Tier 2 conformance gate.
# Never apply line-ending normalisation to them: CRLF conversion would change
# every byte and make a correct Godot port fail byte-for-byte comparison, or --
# worse -- silently change what "identical" means depending on who checked out.
fixtures/** -text

# UE-extracted scenario records are machine-generated reference data, written by
# WorldEngine/Scripts/extract_scenario_data.py with explicit LF newlines. CRLF
# conversion would make every re-extraction show as a whole-file diff and would change
# the bytes Scenarios.cs must reproduce.
migration-data/*.json -text

# Godot project files are authored and consumed as LF by the Godot importer.
# The repo has core.autocrlf=true but no rule covering the Godot tree, so .import
# files report as modified on every checkout with no content change: git sees LF on
# disk, normalises to LF for the index, and the stale stat cache still flags them.
# Verified byte-identical to HEAD (hash-object --no-filters) on all 28 .import files.
world-engine-godot/**/*.import text eol=lf
world-engine-godot/**/*.cs     text eol=lf
world-engine-godot/**/*.gd     text eol=lf
world-engine-godot/**/*.tscn   text eol=lf
