# UE local session - Android File Server token (per-machine, do not commit)
# SecurityToken in WorldEngine/Config/DefaultEngine.ini is a UE session ID, not a secret - removed from repo per CEO 2026-09-03
# Local overrides use WorldEngine/Config/DefaultEngine.ini.local or Saved/Config/ (both ignored)
Plugins/**/ThirdParty/ASFDK/

# Godot
.godot/
.import/
export.cfg
export_presets.cfg

# Godot-cpp is a registered submodule of THIS repo (see root .gitmodules),
# living at world-engine-godot/godot-cpp. Only the stray root-level copies are
# scratch. These patterns are anchored with a leading slash on purpose: an
# unanchored `godot-cpp/` would also match the real submodule path and silently
# shadow it if the gitlink were ever dropped from the index.
/godot-cpp.zip
/godot-cpp/

# Godot add-ons/extensions are local-only; godot-cpp above is the sole
# exception and remains tracked as our submodule. This does not untrack
# add-ons already committed to the repository.
world-engine-godot/addons/
world-engine-godot/ml-MODELS/
ziva_agent_DUPLICATE_moved_out/
world-engine-godot/.fennara/

# Ignore the accidental godot-cpp source copy at the project root. The
# registered world-engine-godot/godot-cpp submodule is the maintained copy.
world-engine-godot/.clang-format
world-engine-godot/.gdignore
world-engine-godot/.git-blame-ignore-revs
world-engine-godot/.github/
world-engine-godot/.pre-commit-config.yaml
world-engine-godot/CMakeLists.txt
world-engine-godot/LICENSE.md
world-engine-godot/LICENSE.txt
world-engine-godot/Makefile
world-engine-godot/SConstruct
world-engine-godot/binding_generator.py
world-engine-godot/build_profile.json
world-engine-godot/build_profile.py
world-engine-godot/cmake/
world-engine-godot/doc_classes/
world-engine-godot/doc_source_generator.py
world-engine-godot/gdextension/
world-engine-godot/include/godot_cpp/
world-engine-godot/make_interface_header.py
world-engine-godot/methods.py
world-engine-godot/misc/
world-engine-godot/natvis/
world-engine-godot/pyproject.toml
world-engine-godot/src/
world-engine-godot/test/
world-engine-godot/tools/

